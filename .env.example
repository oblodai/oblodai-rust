# Oblodai credentials. SERVER SIDE ONLY — a secret must never reach a browser or a mobile app.
# Copy to `.env` and fill in your own values.

# The merchant's one API key: it signs every route except the public ones.
OBLODAI_PUBLIC_ID=test_oblodai_...
OBLODAI_SECRET=oblodai_test_...

# API origin. Defaults to https://api.oblodai.com. A path prefix is kept.
# OBLODAI_BASE_URL=https://api.oblodai.com

# Permit a plain-http base URL beyond loopback (a self-hosted gateway on a private network, CI).
# OBLODAI_ALLOW_INSECURE=1

# Admin token of a self-hosted gateway; only the merchant-provisioning routes use it.
# OBLODAI_ADMIN_TOKEN=...

# debug | info | warn | error — installs a stderr logger. Secrets and signatures are redacted.
# OBLODAI_LOG=debug

# The endpoint secret from webhooks().register() / rotate_secret(), for the receiver example.
# OBLODAI_WEBHOOK_SECRET=whsec_...
# OBLODAI_WEBHOOK_SECRET_PREV=whsec_...

# A running gateway for the live tests (cargo test -- --ignored).
# OBLODAI_LIVE_URL=http://127.0.0.1:8095
